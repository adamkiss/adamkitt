{
	"name": "tpl-project-authid/tpl-project-name",
	"description": "tpl-project-description",
	"type": "project",
	"homepage": "https://tpl-project-homepage.com",
	"authors": [
		{
			"name": "tpl-project-author"
		}
	],
	"require": {
		"php": ">=8.4.0",
		"getkirby/cms": "^5.5"
	},
	"config": {
		"optimize-autoloader": true,
		"allow-plugins": {
			"getkirby/composer-installer": true
		}
	},
	"extra": {
